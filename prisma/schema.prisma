generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Persona {
  id          String    @id @default(cuid())
  name        String
  tone        String
  catchphrase String    // JSON array string
  taboo       String    // JSON array string
  expertise   String    // JSON array string
  visualStyle String
  accounts    Account[]
  contents    Content[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Account {
  id          String   @id @default(cuid())
  platform    String   // xiaohongshu | wechat | douyin | bilibili
  accountName String
  accountId   String?
  connected   Boolean  @default(false)
  persona     Persona  @relation(fields: [personaId], references: [id])
  personaId   String
  createdAt   DateTime @default(now())
}

model Topic {
  id                  String    @id @default(cuid())
  keyword             String
  title               String
  description         String    @default("")
  heatScore           Int       @default(0)
  competitionScore    Int       @default(0)
  matchScore          Int       @default(0)
  source              String    @default("manual") // hot | trending | manual | ai
  tags                String    @default("[]") // JSON array string
  suggestedPublishTime DateTime?
  contents            Content[]
  createdAt           DateTime  @default(now())
}

model Content {
  id          String          @id @default(cuid())
  topicId     String?
  topic       Topic?          @relation(fields: [topicId], references: [id])
  personaId   String
  persona     Persona         @relation(fields: [personaId], references: [id])
  status      String          @default("draft") // draft | generating | review | approved | published | failed
  versions    ContentVersion[]
  publishTasks PublishTask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ContentVersion {
  id               String    @id @default(cuid())
  contentId        String
  content          Content   @relation(fields: [contentId], references: [id])
  platform         String    // xiaohongshu | wechat | douyin | bilibili
  title            String
  body             String
  tags             String    @default("[]") // JSON array string
  coverImagePrompt String?
  coverImageUrl    String?
  cardImageUrls    String    @default("[]") // JSON array string
  wordCount        Int       @default(0)
  isEdited         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PublishTask {
  id          String    @id @default(cuid())
  contentId   String
  content     Content   @relation(fields: [contentId], references: [id])
  platform    String
  status      String    @default("pending") // pending | scheduled | publishing | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  result      String?
  error       String?
  createdAt   DateTime  @default(now())
}
